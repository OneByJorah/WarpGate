# EdgeGateway — Environment Configuration
# Copy this file to .env and fill in your values.
# This is for reference only — the actual config is written to /etc/EdgeGateway/config.env

# ── Network Interfaces ────────────────────────────────────
WAN_IFACE=eth0
AP_IFACE=wlan0

# ── WiFi Access Point ──────────────────────────────────────
AP_SSID=PiGateway
AP_PASS=<set-value>
AP_CHANNEL=6
AP_COUNTRY=US

# ── AP Network ─────────────────────────────────────────────
AP_IP=<set-value>
AP_SUBNET=<set-value>
AP_DHCP_START=<set-value>
AP_DHCP_END=<set-value>

# ── Cloudflare WARP ────────────────────────────────────────
WARP_MTU=1280

# ── Dashboard ──────────────────────────────────────────────
DASHBOARD_PORT=5000

# ── Telegram Bot (optional) ─────────────────────────────────
BOT_TOKEN=<set-value>
ADMIN_CHAT_ID=
